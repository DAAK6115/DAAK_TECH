        },
        {
          "ruleId": "strix-coverage/csrf-ambient-authority",
          "ruleIndex": 4,
          "kind": "notApplicable",
          "level": "none",
          "message": {
            "text": "CSRF / ambient authority — Not applicable: POST /api/contact anonymous submission\n\nRoute consumes no cookies, HTTP authentication, authorization token, or victim-associated persisted state. Cross-origin public submissions carry the same anonymous authority available by direct submission; missing origin validation is not an authenticated CSRF vulnerability."
          },
          "locations": [
            {
              "logicalLocations": [
