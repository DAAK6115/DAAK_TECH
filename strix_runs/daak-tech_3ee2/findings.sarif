          }
        },
        {
          "ruleId": "strix-coverage/runtime-readiness-external-service-isolation",
          "ruleIndex": 7,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Runtime readiness / external-service isolation — No issue identified: Local Next.js runtime preparation at 127.0.0.1:3100\n\nStarted existing production build on loopback with explicit empty mail env; /proc/2199/environ confirms all three email vars present with zero length. Health, root, contact, services, realisations, robots and sitemap GETs return 200; no DB/accounts required and no email requests submitted."
          },
          "locations": [
